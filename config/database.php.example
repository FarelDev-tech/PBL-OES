<?php

// Template konfigurasi database PostgreSQL.
// Salin file ini menjadi database.php, lalu sesuaikan
// password dengan konfigurasi PostgreSQL lokal masing-masing.

$host = 'localhost';
$port = '5432';
$dbname = 'oes_db';
$username = 'postgres';
$password = 'your_password_here'; // Ganti sesuai password PostgreSQL masing-masing.

try {
    $pdo = new PDO(
        "pgsql:host=$host;port=$port;dbname=$dbname",
        $username,
        $password
    );

    $pdo->setAttribute(
        PDO::ATTR_ERRMODE,
        PDO::ERRMODE_EXCEPTION
    );

    $pdo->setAttribute(
        PDO::ATTR_DEFAULT_FETCH_MODE,
        PDO::FETCH_ASSOC
    );

} catch (PDOException $e) {
    die("Koneksi database gagal: " . $e->getMessage());
}
